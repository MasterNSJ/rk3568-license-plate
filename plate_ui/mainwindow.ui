  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralwidget { background-color: #0b1220; }
QLabel { color: #e6edf6; background: transparent; }
QLabel#appBadge { background: #15382f; color: #72e6ba; border: 1px solid #285747; border-radius: 10px; }
QLabel#eyebrowLabel, QLabel#cameraHintLabel, QLabel#fpsTitleLabel, QLabel#latencyTitleLabel, QLabel#inputSizeTitleLabel, QLabel#footerLabel { color: #8192a9; }
QLabel#modeLabel { background: #17382e; color: #7ae7bb; border: 1px solid #285344; border-radius: 9px; padding: 5px 8px; }
QFrame#cameraFrame { background: #0e192a; border: 1px solid #26384e; border-radius: 14px; }
QLabel#cameraTitleLabel { color: #c6d4e5; }
QLabel#cameraStateLabel, QLabel#resultStateLabel { color: #91a3ba; background: #1b293d; border-radius: 7px; padding: 3px 7px; }
QLabel#cameraLabel { color: #7d93ad; }
QFrame#resultFrame { background: #132237; border: 1px solid #2a405a; border-radius: 13px; }
QLabel#plateTitleLabel { color: #a6b7cc; }
QLabel#plateLabel { color: #83ebc7; }
QLabel#confidenceLabel, QLabel#ocrConfidenceLabel { color: #a6b7cc; }
QFrame#metricsFrame { background: #101d2f; border: 1px solid #22364d; border-radius: 12px; }
QFrame#metricDivider1, QFrame#metricDivider2 { background: #2a3b50; border: none; }
QLabel#fpsValueLabel, QLabel#latencyValueLabel, QLabel#inputSizeValueLabel { color: #dce8f7; }
QLabel#statuslabel { color: #a9bdd3; }
QPushButton { color: #d7e3f2; background: #1a2a40; border: 1px solid #354c68; border-radius: 10px; padding: 5px 8px; }
QPushButton:hover { background: #243a55; border-color: #6583a9; }
QPushButton:pressed { background: #304b6d; }
QPushButton#testButton { color: #092c22; background: #6fe0b5; border-color: #6fe0b5; }
QPushButton#testButton:hover { background: #8df0ca; border-color: #8df0ca; }
QPushButton#testButton:pressed { background: #4ac995; border-color: #4ac995; }
QPushButton:disabled, QPushButton#testButton:disabled { color: #66798f; background: #152237; border-color: #25374d; }
QPushButton#exitButton { color: #a9b9cd; background: transparent; }
QPushButton#exitButton:hover { background: #243144; }</string>
